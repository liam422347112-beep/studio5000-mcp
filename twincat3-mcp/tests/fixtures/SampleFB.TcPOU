<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.13">
  <POU Name="SampleFB" Id="{aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SampleFB
VAR_INPUT
	bEnable : BOOL;
END_VAR
VAR_OUTPUT
	bDone : BOOL;
END_VAR
VAR
	nCnt : INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF bEnable THEN
	nCnt := nCnt + 1;
	bDone := nCnt >= 10;
ELSE
	nCnt := 0;
	bDone := FALSE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
